{
  "name": "agentling",
  "version": "1.0.0",
  "description": "A desktop pet that shows what your AI coding agent is doing: idle, thinking, working or waiting for you.",
  "license": "MIT",
  "main": "src/main/index.js",
  "keywords": [
    "ai-agent",
    "claude-code",
    "desktop-pet",
    "electron",
    "status",
    "hooks",
    "adapters"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "setup": "npm install && node scripts/ensure-electron.js && node scripts/connect.js",
    "connect": "node scripts/connect.js",
    "disconnect": "node scripts/connect.js --disconnect",
    "doctor": "node scripts/doctor.js",
    "test": "node --test",
    "theme:new": "node scripts/new-theme.js"
  },
  "devDependencies": {
    "electron": "^44.9.2"
  },
  "bin": {
    "agentling-hook": "bin/agentling-hook.js"
  }
}
